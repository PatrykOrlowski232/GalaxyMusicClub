{
  "name": "galaxy-music-club",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:admin": "npm run dev --prefix admin",
    "dev:all": "npx concurrently -k -n web,admin -c cyan,magenta \"npm run dev\" \"npm run dev:admin\"",
    "build": "next build",
    "build:admin": "npm run build --prefix admin",
    "start": "next start",
    "start:admin": "npm run start --prefix admin",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mysql",
    "preview": "powershell -ExecutionPolicy Bypass -File ./scripts/preview.ps1",
    "db:seed-staff": "tsx scripts/seed-staff.ts",
    "promoters:backfill-codes": "tsx scripts/backfill-promoter-codes.ts",
    "traffic:snapshot": "tsx scripts/snapshot-traffic.ts",
    "db:migrate": "bash scripts/migrate.sh",
    "db:backup": "bash scripts/backup-mysql.sh",
    "db:dump-schema": "tsx scripts/dump-schema.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.76.0",
    "drizzle-orm": "^0.45.3",
    "hash-wasm": "^4.12.0",
    "jose": "^6.2.12",
    "mysql2": "^3.24.5",
    "next": "^16.3.8",
    "nodemailer": "^10.0.15",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
